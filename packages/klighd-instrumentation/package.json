{
    "name": "@kieler/klighd-instrumentation",
    "version": "0.1.0",
    "description": "KLighD diagram instrumentation for recording diagram sessions",
    "license": "EPL-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kieler/klighd-vscode",
        "directory": "packages/klighd-instrumentation"
    },
    "scripts": {
        "clean": "rimraf lib pack",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "test": "mocha --require ts-node/register --require ignore-styles --require reflect-metadata --recursive \"test/**/*.{ts,tsx}\"",
        "test-watch": "mocha --watch --watch-files \"src/**/*.ts\" --watch-files \"test/**/*.ts\" --require ts-node/register --require ignore-styles --require reflect-metadata --recursive \"test/**/*.{ts,tsx}\"",
        "watch": "tsc -w"
    },
    "files": [
        "lib",
        "src"
    ],
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "require": "./lib/index.js",
            "default": "./lib/index.js"
        }
    },
    "dependencies": {
        "@rrweb/record": "^2.1.1",
        "@rrweb/types": "^2.1.1",
        "inversify": "^6.0.2",
        "sprotty": "^1.3.0",
        "sprotty-protocol": "^1.3.0",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@kieler/klighd-core": "^0.8.0"
    },
    "devDependencies": {
        "@kieler/klighd-core": "file:../klighd-core",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.3",
        "chai": "^4.3.10",
        "fake-indexeddb": "^6.2.5",
        "mocha": "^12.0.3",
        "rimraf": "^4.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "typesVersions": {
        "*": {
            "control-view": [
                "lib/control-view/index.d.ts"
            ],
            "webview": [
                "lib/webview/index.d.ts"
            ],
            "shared": [
                "lib/shared/index.d.ts"
            ]
        }
    }
}
