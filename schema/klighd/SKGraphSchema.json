{
    "$id": "https://github.com/kieler/klighd-vscode/tree/main/schema/klighd/SKGraphSchema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SKElement",
    "type": "object",
    "required": ["data", "properties", "type"],
    "properties": {
        "data": {
            "type": "array",
            "items": [
                {
                    "$ref": "#/definitions/KGraphData"
                }
            ],
            "default": []
        },
        "properties": {
            "type": "object",
            "default": {}
        },
        "type": {
            "type": "string"
        }
    },
    "definitions": {
        "SModelElement": {
            "type": "object",
            "required": ["type", "id", "children"],
            "properties": {
                "type": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "children": {
                    "type": "array",
                    "items": [
                        {
                            "$ref": "#/definitions/SModelElement"
                        }
                    ],
                    "default": []
                },
                "trace": {
                    "type": "string"
                }
            }
        },
        "SShapeElement": {
            "allOf": [{"$ref": "#/definitions/SModelElement"}],
            "required": ["size"],
            "properties": {
                "size": {
                    "type": "object",
                    "properties": {
                        "width": {
                            "type": "number"
                        },
                        "height": {
                            "type": "number"
                        }
                    },
                    "default": { "width": 0.0, "height": 0.0 }
                },
                "position": {
                    "type": "object",
                    "properties": {
                        "x": {
                            "type": "number"
                        },
                        "y": {
                            "type": "number"
                        }
                    },
                    "default": { "x": 0.0, "y": 0.0 }
                }
            }
            
        },
        "SKGraph": {
            "allOf": [{"$ref": "#"}, {"$ref": "#/definitions/SModelElement"}],
            "required": ["type", "revision"],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "graph"
                },
                "revision": {
                    "type": "number"
                },
                "children": {
                    "type": "array",
                    "required": ["items"],
                    "items": [
                        {
                            "$ref": "#/definitions/SModelElement"
                        }
                    ],
                    "default": [],
                    "minItems": 1,
                    "maxItems": 1
                }
            }
        },
        "SKNode": {
            "allOf": [{"$ref": "#"}, {"$ref": "#/definitions/SShapeElement"}],
            "required": ["type"],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "node"
                }
            }
        },
        "SKLabel": {
            "allOf": [{"$ref": "#"}, {"$ref": "#/definitions/SModelElement"}],
            "required": ["type", "text"],
            "properties": {
                "text": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "default": "label"
                }
            }
        },
        "SKEdge": {
            "allOf": [{"$ref": "#"}, {"$ref": "#/definitions/SModelElement"}],
            "required": ["type", "sourceId", "targetId"],
            "properties": {
                "sourceId": {
                    "type": "string"
                },
                "targetId": {
                    "type": "string"
                },
                "junctionPoints": {
                    "type": "array",
                    "items": [
                        {
                            "type": "object",
                            "properties": {
                                "x": {
                                    "type": "number"
                                },
                                "y": {
                                    "type": "number"
                                }
                            }
                        }
                    ],
                    "default": []
                },
                "type": {
                    "type": "string",
                    "default": "edge"
                }
            }
        },
        "SKPort": {
            "allOf": [{"$ref": "#"}, {"$ref": "#/definitions/SShapeElement"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "port"
                }
            }
        },
        "KGraphData": {
            "properties": {
                "properties": {
                    "type": "object",
                    "default": {}
                }
            }
        },
        "KRendering": {
            "allOf": [{"$ref": "#/definitions/KGraphData"}, {"$ref": "#/definitions/KStyleHolder"}],
            "properties": {
                "parent": {
                    "$ref": "#/definitions/KContainerRendering"
                },
                "placementData": {
                    "$ref": "#/definitions/KPlacementData"
                },
                "styles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/KStyle"
                    },
                    "default": []
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/KAction"
                    },
                    "default": []
                },
                "type": {
                    "type": "string",
                    "default": "KRenderingImpl"
                }
            }
        }, 
        "KContainerRendering": {
            "allOf": [{"$ref": "#/definitions/KRendering"}],
            "properties": {
                "children": {
                    "type": "array",
                    "items": [
                        {"$ref": "#/definitions/KRendering"}
                    ],
                    "default": []
                
                },
                "childPlacement": {
                    "$ref": "#/definitions/KPlacement"
                },
                "type": {
                    "type": "string",
                    "default": "KContainerRenderingImpl"
                }
            }
        },
        "KCustomRendering": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "className": {
                    "type": "string"
                },
                "bundleName": {
                    "type": "string"
                },
                "figureObject": {
                    "type": "object"
                },
                "type": {
                    "type": "string",
                    "default": "KCustomRenderingImpl"
                }
            }
        },
        "KChildArea": {
            "allOf": [{"$ref": "#/definitions/KRendering"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KChildAreaImpl"
                }
            }
        },
        "KRectangle": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KRectangleImpl"
                }
            }
        },
        "KRoundedRectangle": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "cornerWidth": {
                    "type": "number"
                },
                "cornerHeight": {
                    "type": "number"
                },
                "type": {
                    "type": "string",
                    "default": "KRoundedRectangleImpl"
                }
            }
        },
        "KPolyline": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "points": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/KPosition"
                    },
                    "default": []
                },
                "type": {
                    "type": "string",
                    "default": "KPolylineImpl"
                },
                "junctionPointRendering": {
                    "$ref": "#/definitions/KRendering"
                }
            }
        },
        "KRoundedBendsPolyline": {
            "allOf": [{"$ref": "#/definitions/KPolyline"}],
            "properties": {
                "bendRadius": {
                    "type": "number"
                },
                "type": {
                    "type": "string",
                    "default": "KRoundedBendsPolylineImpl"
                }
            }
        },
        "KPolygon": {
            "allOf": [{"$ref": "#/definitions/KPolyline"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KPolygonImpl"
                }
            }
        },
        "KSpline": {
            "allOf": [{"$ref": "#/definitions/KPolyline"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KSplineImpl"
                }
            }
        },
        "KImage": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "bundleName": {
                    "type": "string"
                },
                "imagePath": {
                    "type": "string"
                },
                "imageObject": {
                    "type": "object"
                },
                "clipShape": {
                    "$ref": "#/definitions/KRendering"
                },
                "type": {
                    "type": "string",
                    "default": "KImageImpl"
                }
            }
        },
        "KEllipse": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KEllipseImpl"
                }
            }
        },
        "KArc": {
            "allOf": [{"$ref": "#/definitions/KContainerRendering"}],
            "properties": {
                "startAngle": {
                    "type": "number"
                },
                "arcAngle": {
                    "type": "number"
                },
                "arcType": {
                    "$ref": "#/definitions/Arc" 
                },
                "type": {
                    "type": "string",
                    "default": "KArcImpl"
                }
            }
        },
        "KText": {
            "allOf": [{"$ref": "#/definitions/KRendering"}],
            "properties": {
                "text": {
                    "type": "string"
                },
                "cursorSelectable": {
                    "type": "boolean",
                    "default": false
                },
                "editable": {
                    "type": "boolean",
                    "default": false
                },
                "type": {
                    "type": "string",
                    "default": "KTextImpl"
                }
            }
        },
        "KPlacementData": {
            "type": "object", 
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KPlacementDataImpl"
                }
            }
        },
        "KDecoratorPlacementData": {
            "allOf": [{"$ref": "#/definitions/KPlacementData"}],
            "properties": {
                "absolute": {
                    "type": "number" 
                },
                "xOffset": {
                    "type": "number" 
                },
                "yOffset": {
                    "type": "number" 
                },
                "rotateWithLine": {
                    "type": "boolean"
                },
                "width": {
                    "type": "number" 
                },
                "height": {
                    "type": "number" 
                },
                "relative": {
                    "type": "number" 
                },
                 "type": {
                    "type": "string",
                    "default": "KDecoratorPlacementDataImpl"
                }
            }
        },
        "KPointPlacementData": {
            "allOf": [{"$ref": "#/definitions/KPlacementData"}],
            "properties": {
                "referencePoint": {
                    "$ref": "#/definitions/KPosition"
                },
                "horizontalAlignment": {
                    "$ref": "#/definitions/HorizontalAlignment"
                },
                "verticalAlignment": {
                    "$ref": "#/definitions/VerticalAlignment"
                },
                "horizontalMargin": {
                    "type": "number",
                    "default": 0
                },
                "verticalMargin": {
                    "type": "number",
                    "default": 0
                },
                "minWidth": {
                    "type": "number",
                    "default": 0
                },
                "minHeight": {
                    "type": "number",
                    "default": 0
                },
                "type": {
                    "type": "string",
                    "default": "KPointPlacementDataImpl"
                }
            }
        },
        "KAreaPlacementData": {
            "allOf": [{"$ref": "#/definitions/KPlacementData"}],
            "properties": {
                "topLeft": {
                    "$ref": "#/definitions/KPosition"
                },
                "bottomRight": {
                    "$ref": "#/definitions/KPosition"
                },
                "type": {
                    "type": "string",
                    "default": "KAreaPlacementDataImpl"
                }
            }
        },
        "KGridPlacementData": {
            "allOf": [{"$ref": "#/definitions/KAreaPlacementData"}],
            "properties": {
                "minCellWidth": {
                    "type": "number",
