                },
                "flexibleHeight": {
                    "type": "boolean",
                    "default": true
                },
                "type": {
                    "type": "string",
                    "default": "KGridPlacementDataImpl"
                } 
            }
        },
        "KPosition": {
            "type": "object",
            "properties": {
                "x": {
                    "$ref": "#/definitions/KXPosition"
                },
                "y": {
                    "$ref": "#/definitions/KYPosition"
                },
                "type": {
                    "type": "string",
                    "default": "KPositionImpl"
                }
            }
        },
        "KXPosition": {
            "type": "object",
            "properties": {
                "absolute": {
                    "type": "number"
                },
                "relative": {
                    "type": "number"
                },
                "type": {
                    "type": "string",
                    "default": "KXPositionImpl"
                }
            }
        },
        "KYPosition": {
            "type": "object",
            "properties": {
                "absolute": {
                    "type": "number"
                },
                "relative": {
                    "type": "number"
                },
                "type": {
                    "type": "string",
                    "default": "KYPositionImpl"
                }
            }
        },
        "KLeftPosition": {
            "allOf": [{"$ref": "#/definitions/KXPosition"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KLeftPositionImpl"
                }
            }
        },
        "KRightPosition": {
            "allOf": [{"$ref": "#/definitions/KXPosition"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KRightPositionImpl"
                }
            }
        },
        "KTopPosition": {
            "allOf": [{"$ref": "#/definitions/KYPosition"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KTopPositionImpl"
                }
            }
        },
        "KBottomPosition": {
            "allOf": [{"$ref": "#/definitions/KYPosition"}],
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KBottomPositionImpl"
                }
            }
        },
        "KPlacement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "default": "KPlacementImpl"
                }
            }
        },
        "KGridPlacement": {
            "allOf": [{"$ref": "#/definitions/KPlacement"}],
            "properties": {
