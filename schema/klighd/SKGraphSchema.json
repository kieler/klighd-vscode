                    "type": "string",
                    "default": "KFontNameImpl"
                }
            }
        },
        "KFontSize": {
           "allOf": [{"$ref": "#/definitions/KStyle"}],
            "properties": { 
                "size": {
                    "type": "integer"
                },
                "scaleWithZoom": {
                    "type": "boolean"
                },
                "type": {
                    "type": "string",
                    "default": "KFontSizeImpl"
                }
            }
        },
