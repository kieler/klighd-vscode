{
    "name": "@kieler/klighd-cli",
    "version": "0.8.1",
    "description": "Standalone web view for klighd-core diagrams",
    "author": "KIELER <kieler@rtsys.informatik.uni-kiel.de>",
    "license": "EPL-2.0",
    "keywords": [
        "sprotty",
        "klighd",
        "diagram",
        "standalone"
    ],
    "main": "./lib/server.js",
    "bin": {
        "klighd": "./lib/klighd.js"
    },
    "files": [
        "lib",
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rimraf lib dist bin pack",
        "lint": "eslint .",
        "build": "run-p --print-label \"build:*\"",
        "build:app": "webpack --mode production --devtool hidden-source-map",
        "build:server": "tsc -p ./tsconfig.server.json",
        "watch": "run-p --print-label \"watch:*\"",
        "watch:app": "webpack --watch --mode development --devtool source-map",
        "watch:server": "tsc -w -p ./tsconfig.server.json",
        "prepackage": "node ./scripts/inject-version.js",
        "package": "pkg -c pkg.json ./lib/klighd.js",
        "prepackage:node": "node ./scripts/inject-version.js",
        "package:node": "rimraf pack && mkdir pack && npm pack --pack-destination pack",
        "start": "node ./lib/main.js",
        "socket": "node ./lib/main.js --ls_port=5007"
    },
    "dependencies": {
        "@fastify/static": "^10.1.12",
        "@fastify/websocket": "^11.3.7",
        "commander": "^15.1.0",
        "fastify": "^5.12.8",
        "get-port": "^7.2.0",
        "open": "^11.0.4",
        "pino-pretty": "^13.2.0",
        "vscode-jsonrpc": "~9.0.3",
        "vscode-ws-jsonrpc": "^4.0.3",
        "ws": "^8.23.0"
    },
    "devDependencies": {
        "@kieler/klighd-core": "^0.8.1",
        "@types/ws": "^8.18.2",
        "@yao-pkg/pkg": "^6.25.0",
        "buffer": "^6.0.3",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.5",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "^5.6.8",
        "mini-css-extract-plugin": "^2.10.2",
        "npm-run-all2": "^9.0.4",
        "os-browserify": "^0.3.0",
        "process": "^0.11.10",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.4",
        "setimmediate": "^1.0.5",
        "sprotty-protocol": "^1.4.0",
        "stream-browserify": "^3.0.0",
        "ts-loader": "^9.6.2",
        "vscode-languageserver-protocol": "^3.18.5",
        "webpack": "^5.113.0",
        "webpack-cli": "^7.3.1"
    }
}
