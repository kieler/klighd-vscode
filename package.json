{
    "private": true,
    "author": "KIELER <kieler@rtsys.informatik.uni-kiel.de>",
    "license": "EPL-2.0",
    "bugs": {
        "url": "https://github.com/kieler/klighd-vscode/issues"
    },
    "homepage": "https://rtsys.informatik.uni-kiel.de/kieler",
    "engines": {
        "node": ">=24",
        "yarn": "1.x"
    },
    "workspaces": [
        "applications/*",
        "packages/*"
    ],
    "scripts": {
        "clean": "lerna run clean --parallel",
        "lint": "lerna run lint --parallel",
        "lint-fix": "lerna run lint-fix --parallel",
        "prebuild": "yarn clean",
        "build": "lerna run build",
        "watch": "lerna run watch --parallel",
        "package": "lerna run build && lerna run package --parallel",
        "package:instrumented": "lerna run build --scope @kieler/klighd-core --scope @kieler/klighd-instrumentation --include-dependencies && yarn --cwd applications/klighd-vscode run package:instrumented",
        "prettier": "prettier --write applications/**/src/ applications/klighd-vscode/src-webview/ packages/**/src/ packages/**/styles/ packages/**/test/",
        "distribute": "lerna run build && lerna run distribute --parallel",
        "test": "mocha --require ts-node/register --require ignore-styles --require reflect-metadata --recursive \"packages/**/test/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "chai": "^6.3.0",
        "eslint": "^8.57.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.7",
        "ignore-styles": "5.0.1",
        "lerna": "^10.1.3",
        "mocha": "^12.0.3",
        "prettier": "^3.10.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "version": "0.0.1"
}
